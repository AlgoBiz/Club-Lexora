# Production Django Settings
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=your-production-secret-key-change-this
DJANGO_SETTINGS_MODULE=core.settings.prod
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# PostgreSQL Database Settings (Production Only)
DBNAME=travel_db_prod
DBUSER=travel_user_prod
DBPASSWORD=strong-password-here
DBHOST=db
DBPORT=5432

# Time Zone
TIME_ZONE=Asia/Kolkata

# Email Settings
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# Admin URL (for security)
DJANGO_ADMIN_URL=secure-admin/
